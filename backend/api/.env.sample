# Local settings for running the API outside Lambda. Copy to .env (git-ignored) and load it:
#   cp .env.sample .env && set -a && . ./.env && set +a
# Deployed Lambdas don't read this file; Terraform sets the same variables (infra/locals.tf).

# Required. Any long random string locally; Terraform generates the deployed one.
JWT_SECRET=change-me-local-dev-secret
JWT_EXPIRES_MINUTES=480

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

IS_LOCAL=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=project_tracker
# The workshop VM uses postgres / postgres123. On a Mac with Homebrew Postgres, use your login name and an empty password.
POSTGRES_USER=postgres
POSTGRES_PASS=postgres123
