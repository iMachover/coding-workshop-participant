              "raw": "{\n  \"name\": \"Not allowed\",\n  \"department_id\": \"{{departmentId}}\",\n  \"manager_id\": \"{{managerId}}\",\n  \"start_date\": \"2026-11-01\",\n  \"end_date\": \"2027-02-28\",\n  \"budget\": 1\n}"
