        {
          "name": "Create project - end before start",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad dates\",\n  \"department_id\": \"{{departmentId}}\",\n  \"manager_id\": \"{{managerId}}\",\n  \"start_date\": \"2027-02-28\",\n  \"end_date\": \"2026-11-01\",\n  \"budget\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('end_date field error', () => pm.expect(pm.response.json().error.fields).to.have.property('end_date'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update project - manager changes budget",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/projects/{{managerProjectId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budget\": 120000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update project - manager cannot reassign manager",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/projects/{{managerProjectId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"manager_id\": \"{{managerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update project - employee token",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/projects/{{managerProjectId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"x\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Archive project - admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/{{newProjectId}}/archive",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('archived', () => pm.expect(pm.response.json().is_archived).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Archive project - already archived",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/{{newProjectId}}/archive",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "List archived projects - admin",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects?archived=true",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('contains the archived project', () => pm.expect(pm.response.json().map(p => p.id)).to.include(pm.collectionVariables.get('newProjectId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "List archived projects - manager token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects?archived=true",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restore project - admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/{{newProjectId}}/restore",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('restored', () => pm.expect(pm.response.json().is_archived).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Archive project - manager token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/{{managerProjectId}}/archive",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
