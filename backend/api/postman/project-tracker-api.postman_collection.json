        },
        {
          "name": "Employee overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('active milestone', () => pm.expect(body.active_milestone.name).to.eql('Workload migration'));",
                  "pm.test('no completed tasks listed', () => pm.expect(body.tasks.every(t => t.status !== 'completed')).to.be.true);",
                  "pm.test('capacity 40 h', () => pm.expect(body.week.capacity_hours).to.eql(40));"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee overview - manager token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/overview",
            "header": [
