{
  "info": {
    "name": "Project Tracker API",
    "description": "Authentication and Overview slices. Run 'Login' first; it stores the emp001 token in the collection variable used by the other requests. The Overview folder logs in the manager and admin itself.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/api",
      "description": "Local proxy. Cloud: https://<cloudfront-domain>/api/api. Direct uvicorn: http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "managerProjectId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"emp001\",\n  \"password\": \"Employee123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has token and user', () => { pm.expect(body.token).to.be.a('string'); pm.expect(body.user.username).to.eql('emp001'); });",
              "pm.test('never exposes password hash', () => pm.expect(body.user).to.not.have.property('password_hash'));",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"emp001\",\n  \"password\": \"wrong\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('error envelope', () => { const b = pm.response.json(); pm.expect(b.success).to.eql(false); pm.expect(b.error.code).to.eql('INVALID_CREDENTIALS'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - missing password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"emp001\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('field error', () => pm.expect(pm.response.json().error.fields).to.have.property('password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "pm.test('is emp001', () => pm.expect(pm.response.json().username).to.eql('emp001'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - no token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Overview",
      "description": "One call per role's Overview page. Run 'Login' (emp001) first; this folder logs in mgr001 and adm001 itself.",
      "item": [
        {
          "name": "Login as manager (mgr001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mgr001\",\n  \"password\": \"Manager123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('managerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin (adm001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"adm001\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('active milestone', () => pm.expect(body.active_milestone.name).to.eql('Workload migration'));",
                  "pm.test('no completed tasks listed', () => pm.expect(body.tasks.every(t => t.status !== 'completed')).to.be.true);",
                  "pm.test('capacity 40 h', () => pm.expect(body.week.capacity_hours).to.eql(40));"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee overview - manager token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('focus is INF-024', () => pm.expect(body.focus.code).to.eql('INF-024'));",
                  "pm.test('3 milestones, last locked', () => pm.expect(body.focus.milestones.map(m => m.locked)).to.eql([false, false, true]));",
                  "pm.test('one task to review', () => pm.expect(body.stats.pending_approvals).to.eql(1));",
                  "pm.collectionVariables.set('managerProjectId', body.focus.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager overview - own project_id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/overview?project_id={{managerProjectId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.test('same project', () => pm.expect(String(pm.response.json().focus.id)).to.eql(String(pm.collectionVariables.get('managerProjectId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager overview - project_id not a number",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/overview?project_id=abc",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('field error', () => pm.expect(pm.response.json().error.fields).to.have.property('project_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager overview - another manager's project",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manager/overview?project_id=999999",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin overview",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('portfolio has both projects', () => pm.expect(body.portfolio.map(p => p.code)).to.include.members(['INF-024', 'OPS-018']));",
                  "pm.test('latest 4 audit entries', () => pm.expect(body.recent_audit).to.have.lengthOf(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin overview - employee token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/overview",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin overview - no token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/overview"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
