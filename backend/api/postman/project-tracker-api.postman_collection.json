        {
          "name": "Create project - admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman project\",\n  \"description\": \"Created from the Postman collection\",\n  \"department_id\": \"{{departmentId}}\",\n  \"manager_id\": \"{{managerId}}\",\n  \"start_date\": \"2026-11-01\",\n  \"end_date\": \"2027-02-28\",\n  \"budget\": 15000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('code generated', () => pm.expect(pm.response.json().code).to.match(/^[A-Z]{3}-\\d{3}$/));",
                  "pm.collectionVariables.set('newProjectId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create project - manager token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects",
            "header": [
