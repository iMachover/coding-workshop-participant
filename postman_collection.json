{
  "info": {
    "name": "Facilities Helpdesk API (core)",
    "description": "Every route of the core service. Run the whole collection top to bottom: each request saves the ids the next ones need (userId, ticketId, ...) into collection variables.\n\nPoint `baseUrl` at your API (default: local Uvicorn). Auth is the dev-only `X-User-Id` header, set once at collection level from `{{userId}}`. Full reference: postman_testing.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-User-Id",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{userId}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is JSON', () => pm.response.to.be.json);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/core"
    },
    {
      "key": "password",
      "value": "postman-pass-123"
    },
    {
      "key": "missingId",
      "value": "2147483647",
      "description": "Largest valid id; never exists in practice."
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "otherEmail",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherUserId",
      "value": ""
    },
    {
      "key": "buildingId",
      "value": ""
    },
    {
      "key": "floorId",
      "value": ""
    },
    {
      "key": "seatId",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness check. No auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body', () => pm.expect(pm.response.json()).to.eql({ status: 'ok' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Database health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "db"
              ]
            },
            "description": "Readiness check. 503 `{\"status\":\"error\",\"db\":\"unavailable\"}` if Postgres is down."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body', () => pm.expect(pm.response.json()).to.eql({ status: 'ok', db: 'ok' }));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates an employee. Only @acme.inc emails; password 8-128 chars. The pre-request script makes a unique email each run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"full_name\": \"Postman Tester\",\n  \"phone_number\": \"555-0101\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `postman.${Date.now()}@acme.inc`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('User shape, no password', () => {",
                  "  const user = pm.response.json();",
                  "  pm.expect(user).to.have.all.keys('user_id', 'email', 'full_name', 'phone_number', 'role', 'created_at');",
                  "});",
                  "",
                  "pm.test('Role is employee', () => pm.expect(pm.response.json().role).to.eql('employee'));",
                  "pm.collectionVariables.set('userId', pm.response.json().user_id);"
                ]
              }
            }
          ]
        },
